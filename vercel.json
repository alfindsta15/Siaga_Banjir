{
  "version": 2,
  "builds": [
    {
      "src": "server/public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://siaga-banjir-api.ketupatbot.workers.dev/api/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://siaga-banjir-api.ketupatbot.workers.dev/healthz"
    }
  ]
}
