# Salin ke /etc/siaga-banjir.env lalu isi. Berkas ini berisi rahasia: chmod 600.
PORT=3001
DATA_DIR=/var/lib/siaga-banjir
# Wajib bila di belakang Cloudflare Tunnel / Caddy / Nginx (HTTPS):
TRUST_PROXY=1
# Hanya bila memakai webhook Fonnte (kata acak panjang). Tidak perlu untuk Baileys:
#WEBHOOK_KEY=ganti-dengan-kata-acak-yang-panjang
# MQTT: alat online lewat broker (lihat TUTORIAL.md). Kredensial SERVER (alat memakai kredensial lain):
#MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
#MQTT_USER=siaga-server
#MQTT_PASS=sandi-server-yang-panjang
#MQTT_PREFIX=siaga
# Hanya untuk pertama kali (setelah itu ganti di dashboard). Kosongkan agar dibuat otomatis dan tampil di log:
#ADMIN_PASSWORD=
#DEVICE_KEY=
